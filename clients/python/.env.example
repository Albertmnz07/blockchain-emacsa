# ==========================================================================
# Cliente aguas-ingest — variables de entorno
# ==========================================================================
# Convención:
#
# - AGUAS_PRIVATE_KEY es la única obligatoria. El resto admite default y se
#   puede dejar en blanco.
# - Con todo lo demás vacío, el cliente apunta al `aguas-ingest mock-backend`
#   local en http://127.0.0.1:41337 con el dominio EIP-712 dev. Útil para
#   iterar offline (tier 1 + tier 2 del README).
# - Para apuntar a un entorno real (Caddy + backend desplegado), rellenar
#   el bloque entero — URL + dominio + Basic Auth — con los valores que se
#   proporcionan aparte. Si rellenas sólo algunos, el cliente avisa por
#   stderr antes del POST.
#
# Overrides puntuales sin tocar este fichero: flags `--base-url`,
# `--basic-auth-user`, `--basic-auth-password` del subcomando `send`.

# Clave privada EIP-712 (hex 64 chars, con o sin prefijo 0x).
# Generar con `aguas-ingest keygen`, o usar la que se proporcione para el
# entorno protegido (registrada en SignerRegistry → permite POST real).
AGUAS_PRIVATE_KEY=

# URL base del entorno de destino. Vacío = mock local.
AGUAS_BASE_URL=

# HTTP Basic Auth — sólo en entornos protegidos por Caddy. Vacíos = sin
# header `Authorization`. Se proporcionan aparte usuario y password.
AGUAS_BASIC_AUTH_USER=
AGUAS_BASIC_AUTH_PASSWORD=

# Dominio EIP-712. Tienen que coincidir bit-a-bit con los del backend.
# Vacíos = defaults dev-local (`AguasDeCordoba` / `1` / `1337` / `0x...dead`).
AGUAS_EIP712_NAME=
AGUAS_EIP712_VERSION=
AGUAS_CHAIN_ID=1338
AGUAS_VERIFYING_CONTRACT=
